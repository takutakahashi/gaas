{
  "name": "gaas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cf d1 migrations apply 48b09f17-fa3f-42b2-9d34-a268d63a186f --local --dir migrations",
    "db:migrate:remote": "cf d1 migrations apply 48b09f17-fa3f-42b2-9d34-a268d63a186f --dir migrations",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.25",
    "@vinext/cloudflare": "^1.4.0",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "uuid": "^14.0.3",
    "vinext": "^1.4.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.17",
    "@types/node": "^22.12.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vite-css-modules": "^1.16.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.59.1"
  },
  "type": "module"
}
